.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
node_modules/
# Derived from the step files by `trail.py graph` and `merge`.
graph/
# `trail.py view` without `--out` writes the page beside the trail's steps.
view.html
# A trail's HMAC key is kept outside the trail and outside git.
*.key
.env

# A brief's workspace data is the demo's; brief.json records its digests.
research/*/briefs/*/workspace/data/
# Built by scripts/site.sh.
site/

# The second project's replication sample, rebuilt by demo2/make_data.py; no agent may read it.
research/*/replication/
